# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# The offline FIT venv: LightGBM + scikit-learn, for
# `scripts/fit_postprocess.py --model trees`. Deliberately separate from
# .venv and from the sidecar's, because the SERVING image must never grow
# either dependency — see that script's docstring for the two commands
# that create it.
.venv-fit

# Tooling caches
.pytest_cache/
.coverage
htmlcov/

# Local secrets / host config — never commit. See .env.example.
.env

# Claude Code runtime
.claude/

# Long-term storage of raw radar HDF5 files, fetched from DMI's rolling
# 180-day archive. Far too large to commit and re-fetchable inside the
# retention window.
radar_archive/

# Reproducible artifacts (regenerated by scripts/)
reports/

# Local pulled datasets (strike NDJSON, corpora, etc.) — not committed.
# Using ``data/*`` (not ``data/``) so the negations below can un-ignore
# the committed calibration boundary.
data/*
!data/README.md
!data/denmark_boundary.geojson

# Web Push secrets and local state — the VAPID private key is the
# service's identity and the SQLite file holds subscriber endpoints.
# Both live in the data volume in production; neither is ever committed.
*.pem
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Editor / OS noise
.DS_Store

# Event-review bundles: a few hundred megabytes of radar PNGs plus the
# decision/gauge extracts they are reviewed against. Rebuilt from the VM
# corpus by scripts/build_review_bundle.py, never committed. The annotation
# database is already covered by the *.sqlite rule above.
# Root-anchored on purpose: an unanchored ``review/`` also swallows
# frontend/src/lib/review, which is source.
/review/
/review-bundle-*/
