# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.pytest_cache/
.coverage
htmlcov/

# Local secrets / host config — never commit. See .env.example.
.env

# Claude Code runtime
.claude/

# Long-term storage of raw radar HDF5 files, fetched from DMI's rolling
# 180-day archive. Far too large to commit and re-fetchable inside the
# retention window.
radar_archive/

# Reproducible artifacts (regenerated by scripts/)
reports/

# Local pulled datasets (strike NDJSON, corpora, etc.) — not committed.
# Using ``data/*`` (not ``data/``) so the negations below can un-ignore
# the committed calibration boundary.
data/*
!data/README.md
!data/denmark_boundary.geojson

# Web Push secrets and local state — the VAPID private key is the
# service's identity and the SQLite file holds subscriber endpoints.
# Both live in the data volume in production; neither is ever committed.
*.pem
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# Editor / OS noise
.DS_Store
