# Copy to .env and fill in your own values. .env is gitignored — it holds
# host names and key paths and must never be committed.
#
# Used by sidecar/deploy/deploy.sh (SSH deploy to a remote docker host)
# and read by docker compose for the Compose file's variables.

# --- SSH deploy target -----------------------------------------------------
DEPLOY_SSH_HOST=your-docker-host.example
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=youruser
DEPLOY_SSH_KEY=~/.ssh/your_deploy_key

# Checkout directory on the deploy host.
# Default: /home/$DEPLOY_SSH_USER/dmi-nowcast
#REMOTE_DIR=/home/youruser/dmi-nowcast

# --- Runtime paths / ports on the deploy host ------------------------------
# Published port for the sidecar. Use "address:port" to bind a single
# interface, e.g. 127.0.0.1:8081 to keep it local to the host.
#HOST_PORT=8081

# Persistent corpus archive on the host (bind-mounted into the container
# at /var/lib/dmi-nowcast-corpus). Default: ~/dmi-nowcast-corpus
#CORPUS_HOST_DIR=/home/youruser/dmi-nowcast-corpus

# --- Validation / ops scripts ----------------------------------------------
# Base URL scripts/validate_national.py checks by default.
#DMI_NOWCAST_BASE_URL=http://your-docker-host.example:8081
